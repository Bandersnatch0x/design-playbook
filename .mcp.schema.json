{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "design-playbook/.mcp.schema.json",
  "title": "Repository MCP server configuration",
  "description": "Shape of the repo-root .mcp.json dev configuration: stdio servers only, plus the host's per-call timeout. Kept local because the shipped config carries a HITL timeout field that external MCP config schemas reject.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Path or URL of this schema."
    },
    "mcpServers": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/server"}
    }
  },
  "required": ["$schema", "mcpServers"],
  "additionalProperties": false,
  "$defs": {
    "server": {
      "type": "object",
      "properties": {
        "type": {"type": "string", "enum": ["stdio"]},
        "command": {"type": "string"},
        "args": {"type": "array", "items": {"type": "string"}},
        "env": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "cwd": {"type": "string"},
        "timeout": {"type": "integer", "minimum": 1}
      },
      "required": ["type", "command"],
      "additionalProperties": false
    }
  }
}
