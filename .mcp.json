{
  "$schema": "./.mcp.schema.json",
  "mcpServers": {
    "design-playbook-preview": {
      "type": "stdio",
      "command": "python",
      "args": [
        "packages/design-playbook/mcp/preview/server.py"
      ],
      "timeout": 3600000
    },
    "design-playbook-evidence": {
      "type": "stdio",
      "command": "python",
      "args": [
        "packages/design-playbook/mcp/evidence/server.py"
      ],
      "env": {
        "DESIGN_PLAYBOOK_RUN_ROOT": "."
      },
      "timeout": 3600000
    }
  }
}
