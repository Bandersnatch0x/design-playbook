# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.worktrees/
*.local
.design-playbook/preferences.local.yaml

# Personal planning and temporary artifacts stay local.
.scratch/
/.claude/
.workbuddy/
.workflow/
# Tool caches and regenerated run artifacts (pytest/ruff self-ignore via
# CACHEDIR.TAG, but the intent belongs here explicitly).
.pytest_cache/
.ruff_cache/
.benchmarks/
evidence/
# The Evidence runtime is source, not generated run evidence.
!packages/design-playbook/mcp/evidence/
!packages/design-playbook/tests/evidence/
# Only the existing catalog file is a distribution exception (ADR-0009).
.agents/*
!.agents/plugins/
.agents/plugins/*
!.agents/plugins/marketplace.json
# Guard old locations too; docs/ holds long-lived shared documentation only.
/spec/
/specs/
/plan/
/plans/
/research/
/issue/
/issues/
/ticket/
/tickets/
/docs/spec/
/docs/specs/
/docs/plan/
/docs/plans/
/docs/research/
/docs/issue/
/docs/issues/
/docs/ticket/
/docs/tickets/

# Stray debug screenshots at repo root (showcase/screenshots/ is tracked).
/*.png

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Python (validate.py)
__pycache__/
*.pyc

# Local tool artifacts (codegraph / graphify / playwright-cli / pi-subagents)
.codegraph/
.graphify/
.playwright-cli/
.pi-subagents/
.pi/

# firecrawl scratch output
.firecrawl/

# Stitch design sources stay local (ADR-0034 §6: exports under .stitch/ are
# design sources, never runtime assets; none are tracked). The shipped
# delivery page is mcp/evidence/static_handoff_page.html.
.stitch/
.qoder/

# Local Codex CLI MCP config (dev-session convenience; AGENTS.md rule 8 keeps root dot-dirs out of git)
.codex/

# ZCode editor-local ignore mirror (syncs .gitignore rules for the ZCode IDE)
.zcodeignore
