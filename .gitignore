# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.worktrees/
*.local
.design-playbook/preferences.local.yaml

# Local agent planning, research, dogfood, and temporary artifacts.
.scratch/
.workbuddy/
.workflow/
# .agents/plugins/ is a publish surface (ADR-0009 dual publish; validate.py
# hard-gates on marketplace.json), so it must stay trackable. Ignoring
# `.agents/` wholesale leaves already-tracked files working while silently
# swallowing any new file added there.
.agents/*
!.agents/plugins/
# ADR-0034 §5: handoff artifacts belong under the run tree, not the process
# cwd. This entry papers over that misplacement and retires with the move.
output/

# Stray debug screenshots at repo root (showcase/screenshots/ is tracked).
/*.png

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Python (validate.py)
__pycache__/
*.pyc

# Local tool artifacts (codegraph / graphify / playwright-cli / pi-subagents)
.codegraph/
.graphify/
.playwright-cli/
.pi-subagents/
.pi/

# External-reference research notes (not version-controlled; avoid
# third-party attribution/attribution drift. Keep local only.)
docs/research/

# firecrawl scratch output
.firecrawl/

# Stitch design sources stay local (ADR-0034 §6: exports under .stitch/ are
# design sources, never runtime assets). git cannot re-include a file whose
# parent directory is excluded, so exclude/re-include level by level rather
# than writing `.stitch/` + `!.stitch/...`, which silently tracks everything.
# static-handoff-v1.html is kept tracked as the historical Stitch prototype;
# the shipped delivery page is mcp/evidence/static_handoff_page.html.
.stitch/*
!.stitch/designs/
.stitch/designs/*
!.stitch/designs/static-handoff-v1.html
